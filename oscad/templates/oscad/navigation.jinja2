<header class="navbar navbar-expand-sm bg-body-tertiary border-bottom mb-4">
  <nav class="container" aria-label="{{ _('Main navigation') }}">
    <a class="navbar-brand" href="{{ request.application_url }}">
      OSCAd
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbar-oscad-collapse"
            aria-controls="navbar-oscad-collapse" aria-expanded="false"
            aria-label="{{ _('Toggle navigation') }}">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbar-oscad-collapse">
      <ul class="navbar-nav me-auto">
        {%- for link in toplevel_links -%}
        <li class="nav-item">
          <a class="nav-link {%- if request.path == link[0] %} active{% endif %}"
             {%- if request.path == link[0] %} aria-current="page"{% endif %}
             href="{{ link[0] }}">{{ link[1] }}</a>
        </li>
        {%- endfor -%}
      </ul>
      <ul class="navbar-nav">
        {%- for lang in request.available_locales -%}
        <li class="nav-item">
          <a class="nav-link {%- if request.locale_name == lang %} active{% endif %}"
             {%- if request.locale_name == lang %} aria-current="true"{% endif %}
             href="{{ request.route_path('change_language', lang=lang,
              _query={'next': request.path_qs}) }}">
            {{ lang }}
          </a>
        </li>
        {%- endfor -%}
      </ul>
    </div>
  </nav>
</header>
